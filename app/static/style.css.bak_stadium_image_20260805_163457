  border: 1px solid var(--line);
  border-radius: 18px;
  color: var(--text);
  background: #0b1715;
  box-shadow: 0 34px 100px rgba(0, 0, 0, .58);
  overflow: auto;
}

.card-modal::backdrop {
  background: rgba(2, 7, 6, .82);
