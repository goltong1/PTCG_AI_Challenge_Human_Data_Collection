:root {
  --bg: #07100f;
  --surface: #0d1817;
  --surface-2: #111f1d;
  --surface-3: #162725;
  --line: #29403d;
  --line-soft: #1b302e;
  --text: #f2f7f5;
  --muted: #91a7a2;
  --faint: #5f7772;
  --accent: #8ff26b;
  --accent-deep: #4ecb70;
  --blue: #63b8ff;
  --gold: #ffd36a;
  --danger: #ff737f;
  --shadow: 0 24px 70px rgba(0, 0, 0, .28);
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text);
  font-family: Inter, Pretendard, "Noto Sans KR", "Segoe UI", system-ui, sans-serif;
  background:
    radial-gradient(circle at 7% -10%, rgba(143, 242, 107, .12), transparent 28rem),
    radial-gradient(circle at 100% 2%, rgba(99, 184, 255, .1), transparent 30rem),
    linear-gradient(180deg, #081210, #060d0c 70%);
}

button,
select,
input {
  font: inherit;
}

button,
a,
label {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible,
select:focus-visible,
input:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

button:disabled {
  cursor: not-allowed;
  opacity: .42;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.hidden {
  display: none !important;
}

.app-shell {
  width: min(1720px, calc(100% - 36px));
  margin: 0 auto;
  padding: 18px 0 40px;
}

.topbar {
  min-height: 62px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 24px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 0;
  border: 0;
  color: var(--text);
  background: transparent;
  cursor: pointer;
  text-align: left;
}

.brand-mark {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(143, 242, 107, .45);
  border-radius: 13px;
  color: #0a190f;
  background: linear-gradient(145deg, #b7ff8d, #55d977);
  box-shadow: 0 8px 28px rgba(78, 203, 112, .2);
  font-weight: 950;
  font-size: 22px;
}

.brand small,
.brand strong {
  display: block;
}

.brand small {
  margin-bottom: 3px;
  color: var(--muted);
  font-size: 9px;
  letter-spacing: .18em;
  font-weight: 900;
}

.brand strong {
  font-size: 18px;
  letter-spacing: -.02em;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.button,
.icon-button,
.text-button {
  border: 0;
  color: var(--text);
  cursor: pointer;
}

.button {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 15px;
  border-radius: 11px;
  font-weight: 850;
  font-size: 13px;
  text-decoration: none;
  transition: border-color .14s ease, background .14s ease, transform .14s ease;
}

.button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.button.quiet {
  border: 1px solid var(--line);
  background: rgba(17, 31, 29, .88);
}

.button.quiet:hover:not(:disabled) {
  border-color: #4c6964;
  background: var(--surface-3);
}

.button.primary {
  color: #09200f;
  background: linear-gradient(135deg, #adff88, #57dc77);
  box-shadow: 0 10px 30px rgba(78, 203, 112, .16);
}

.button.primary:hover:not(:disabled) {
  box-shadow: 0 13px 34px rgba(78, 203, 112, .24);
}

.button.disabled,
a.disabled {
  opacity: .35;
  pointer-events: none;
}

.panel {
  border: 1px solid var(--line);
  border-radius: 18px;
  background: linear-gradient(155deg, rgba(17, 31, 29, .96), rgba(10, 21, 20, .96));
  box-shadow: var(--shadow);
}

.kicker {
  display: block;
  margin-bottom: 8px;
  color: var(--accent);
  font-size: 10px;
  font-weight: 950;
  letter-spacing: .18em;
}

h1,
h2,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 0;
  font-size: clamp(38px, 5.2vw, 72px);
  line-height: 1.04;
  letter-spacing: -.06em;
}

h1 em {
  color: var(--accent);
  font-style: normal;
}

h2 {
  margin-bottom: 0;
  font-size: 20px;
  letter-spacing: -.025em;
}

.lobby-intro {
  min-height: 240px;
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(280px, .6fr);
  align-items: end;
  gap: 56px;
  padding: 24px 10px 38px;
}

.lobby-intro p {
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.8;
}

.lobby-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(360px, .75fr);
  gap: 16px;
}

.agent-library,
.match-setup {
  padding: 23px;
}

.section-heading {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 19px;
}

.section-heading.compact {
  margin-bottom: 13px;
}

.section-heading.compact h2 {
  font-size: 17px;
}

.count-pill {
  padding: 6px 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  background: var(--surface);
  font-size: 11px;
  font-weight: 800;
}

.agent-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.agent-card {
  min-width: 0;
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) 10px;
  align-items: center;
  gap: 11px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 13px;
  color: var(--text);
  background: rgba(9, 20, 18, .74);
  cursor: pointer;
  text-align: left;
  transition: transform .14s ease, border-color .14s ease, background .14s ease;
}

.agent-card:hover:not(:disabled) {
  border-color: #55726d;
  transform: translateY(-1px);
}

.agent-card.selected {
  border-color: rgba(143, 242, 107, .72);
  background: linear-gradient(135deg, rgba(143, 242, 107, .12), rgba(78, 203, 112, .04));
  box-shadow: inset 0 0 0 1px rgba(143, 242, 107, .13);
}

.agent-avatar {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid #35504b;
  border-radius: 12px;
  color: #c9ffd2;
  background: linear-gradient(145deg, #213b35, #142724);
  font-size: 12px;
  font-weight: 950;
  letter-spacing: .06em;
}

.agent-card.selected .agent-avatar {
  color: #102213;
  border-color: transparent;
  background: linear-gradient(145deg, #b4ff91, #62dd7c);
}

.agent-card-copy {
  min-width: 0;
}

.agent-card-copy strong,
.agent-card-copy small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-card-copy strong {
  margin-bottom: 5px;
  font-size: 13px;
}

.agent-card-copy small {
  color: var(--muted);
  font-size: 10px;
}

.ready-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-deep);
  box-shadow: 0 0 0 4px rgba(78, 203, 112, .1);
}

.agent-card.invalid .ready-dot {
  background: var(--danger);
  box-shadow: 0 0 0 4px rgba(255, 115, 127, .1);
}

.upload-zone {
  min-height: 76px;
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
  padding: 13px 14px;
  border: 1px dashed #45615b;
  border-radius: 13px;
  color: var(--muted);
  background: rgba(8, 18, 17, .65);
  cursor: pointer;
  transition: border-color .14s ease, background .14s ease;
}

.upload-zone:hover,
.upload-zone.dragging {
  border-color: var(--accent);
  background: rgba(143, 242, 107, .06);
}

.upload-zone input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.upload-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 9px;
  color: var(--accent);
  background: var(--surface-2);
  font-size: 19px;
}

.upload-zone strong,
.upload-zone small {
  display: block;
}

.upload-zone strong {
  margin-bottom: 4px;
  color: var(--text);
  font-size: 12px;
}

.upload-zone small {
  font-size: 10px;
}

.upload-action {
  padding: 7px 9px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--text);
  background: var(--surface-2);
  font-size: 10px;
  font-weight: 900;
}

.trust-note {
  margin-top: 9px;
  color: var(--faint);
  font-size: 9px;
}

.match-setup form {
  display: grid;
  gap: 16px;
}

.field {
  display: grid;
  gap: 8px;
}

.field-label {
  color: var(--muted);
  font-size: 11px;
  font-weight: 850;
}

.field-label small {
  color: var(--faint);
  font-weight: 600;
}

.field select,
.deck-upload {
  width: 100%;
  min-height: 46px;
  border: 1px solid var(--line);
  border-radius: 11px;
  color: var(--text);
  background: #0a1514;
}

.field select {
  padding: 0 12px;
}

.deck-picker {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
}

.deck-picker select {
  min-width: 0;
}

.builder-button {
  min-width: 96px;
  border: 1px solid rgba(143, 242, 107, .42);
  color: var(--accent);
  background: rgba(143, 242, 107, .07);
}

.field-note {
  color: var(--faint);
  font-size: 10px;
  line-height: 1.45;
}

.seat-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
}

.seat-toggle label {
  cursor: pointer;
}

.seat-toggle input {
  position: absolute;
  opacity: 0;
}

.seat-toggle span {
  min-height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--muted);
  background: #0a1514;
  font-size: 12px;
  font-weight: 850;
}

.seat-toggle input:checked + span {
  border-color: rgba(143, 242, 107, .7);
  color: var(--accent);
  background: rgba(143, 242, 107, .08);
}

.deck-upload {
  position: relative;
  min-height: 68px;
  align-content: center;
  padding: 10px 12px;
  cursor: pointer;
}

.deck-upload input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

#deck-file-label {
  overflow: hidden;
  color: var(--faint);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-summary {
  display: grid;
  gap: 5px;
  padding: 13px;
  border: 1px solid var(--line-soft);
  border-radius: 11px;
  background: rgba(143, 242, 107, .035);
}

.match-summary span {
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .12em;
}

.match-summary strong {
  overflow: hidden;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.start-button {
  min-height: 49px;
  justify-content: space-between;
  padding-inline: 18px;
}

.runtime-status {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 17px;
  color: var(--faint);
  font-size: 10px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent-deep);
  box-shadow: 0 0 0 4px rgba(78, 203, 112, .08);
}

.status-dot.warning {
  background: var(--gold);
  box-shadow: 0 0 0 4px rgba(255, 211, 106, .08);
}

.text-button {
  padding: 0;
  color: var(--accent);
  background: transparent;
  font-size: 10px;
  font-weight: 850;
}

.match-bar {
  display: grid;
  grid-template-columns: minmax(250px, 1fr) auto minmax(250px, 1fr);
  align-items: center;
  gap: 14px;
  padding: 10px 14px;
  margin-bottom: 10px;
  box-shadow: none;
}

.match-state {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 11px;
}

.match-state strong,
.match-state small {
  display: block;
}

.match-state strong {
  font-size: 13px;
}

.match-state small {
  margin-top: 2px;
  color: var(--muted);
  font-size: 9px;
}

.turn-badge {
  padding: 6px 9px;
  border: 1px solid rgba(143, 242, 107, .34);
  border-radius: 8px;
  color: var(--accent);
  background: rgba(143, 242, 107, .08);
  font-size: 10px;
  font-weight: 950;
}

.playback {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px;
  border: 1px solid var(--line-soft);
  border-radius: 10px;
  background: #091412;
}

.playback-label {
  margin: 0 5px;
  color: var(--faint);
  font-size: 8px;
  font-weight: 950;
  letter-spacing: .13em;
}

.icon-button {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface-2);
  font-size: 10px;
  font-weight: 950;
}

.icon-button:hover:not(:disabled) {
  border-color: var(--accent);
}

.playback select {
  height: 31px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--text);
  background: var(--surface-2);
  padding: 0 7px;
  font-size: 10px;
  font-weight: 800;
}

.match-meta {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  color: var(--faint);
  font-size: 10px;
}

.agent-chip {
  max-width: 270px;
  overflow: hidden;
  padding: 6px 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  background: var(--surface);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-stage {
  min-height: 66px;
  display: grid;
  grid-template-columns: 102px minmax(0, 1fr) 70px;
  align-items: center;
  gap: 13px;
  padding: 11px 14px;
  margin-bottom: 10px;
  box-shadow: none;
  overflow: hidden;
  position: relative;
}

.action-stage::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: 3px;
  background: var(--muted);
}

.action-stage.ai::before,
.action-stage.thinking::before {
  background: var(--blue);
}

.action-stage.human::before {
  background: var(--accent);
}

.action-actor {
  color: var(--muted);
  font-size: 9px;
  font-weight: 950;
  letter-spacing: .14em;
}

.action-stage.ai .action-actor,
.action-stage.thinking .action-actor {
  color: var(--blue);
}

.action-stage.human .action-actor {
  color: var(--accent);
}

.action-copy {
  min-width: 0;
}

.action-copy strong,
.action-copy span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-copy strong {
  font-size: 14px;
}

.action-copy span {
  margin-top: 4px;
  color: var(--muted);
  font-size: 10px;
}

.thinking-indicator {
  display: flex;
  justify-content: flex-end;
  gap: 5px;
}

.thinking-indicator span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--blue);
  animation: think 1s ease-in-out infinite;
}

.thinking-indicator span:nth-child(2) {
  animation-delay: .13s;
}

.thinking-indicator span:nth-child(3) {
  animation-delay: .26s;
}

@keyframes think {
  0%, 70%, 100% { opacity: .25; transform: translateY(0); }
  35% { opacity: 1; transform: translateY(-4px); }
}

.action-pop .action-copy {
  animation: action-pop .28s ease-out;
}

@keyframes action-pop {
  from { opacity: .25; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

.game-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 410px;
  gap: 10px;
}

.board {
  min-width: 0;
  padding: 14px;
  box-shadow: none;
}

.player-side {
  display: grid;
  gap: 10px;
}

.player-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.player-identity {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.player-identity strong {
  overflow: hidden;
  font-size: 13px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-token {
  padding: 4px 6px;
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--muted);
  background: var(--surface);
  font-size: 8px;
  font-weight: 950;
}

.human-side .seat-token {
  color: var(--accent);
  border-color: rgba(143, 242, 107, .34);
}

.opponent-side .seat-token {
  color: var(--blue);
  border-color: rgba(99, 184, 255, .34);
}

.player-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 5px;
}

.player-stats span {
  padding: 4px 6px;
  border: 1px solid var(--line-soft);
  border-radius: 6px;
  color: var(--faint);
  background: rgba(7, 16, 15, .8);
  font-size: 8px;
}

.player-stats b {
  color: var(--text);
}

.battle-row {
  min-width: 0;
  display: grid;
  grid-template-columns: 162px minmax(0, 1fr);
  gap: 9px;
  align-items: stretch;
}

.active-zone,
.bench-zone,
.hand-zone,
.discard-zone {
  min-width: 0;
  position: relative;
  border: 1px solid var(--line-soft);
  border-radius: 12px;
  background:
    linear-gradient(120deg, rgba(143, 242, 107, .02), transparent),
    rgba(5, 14, 13, .62);
}

.active-zone {
  min-height: 216px;
  display: grid;
  place-items: center;
  padding: 24px 8px 8px;
}

.bench-zone {
  min-height: 216px;
  padding: 24px 8px 8px;
}

.zone-label {
  position: absolute;
  top: 7px;
  left: 9px;
  color: #506a65;
  font-size: 7px;
  font-weight: 950;
  letter-spacing: .16em;
}

.card-row {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 6px;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: thin;
  scrollbar-color: #38534e transparent;
}

.bench-row {
  min-height: 180px;
}

.card-shell {
  position: relative;
  flex: 0 0 146px;
  width: 146px;
  min-height: 204px;
  display: block;
  padding: 0;
  border: 1px solid #38524d;
  border-radius: 10px;
  color: var(--text);
  background: #0a1514;
  overflow: hidden;
  cursor: pointer;
  text-align: left;
  transition: border-color .14s ease, transform .14s ease;
}

.card-shell:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}

.card-shell.compact-card {
  flex-basis: 106px;
  width: 106px;
  min-height: 148px;
}

.card-art-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: .716;
  background: linear-gradient(145deg, #1b312d, #0b1816);
  overflow: hidden;
}

.card-art {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-fallback {
  display: none;
  position: absolute;
  inset: 0;
  place-items: center;
  padding: 10px;
  color: var(--muted);
  background: linear-gradient(145deg, #1b312d, #0b1816);
  font-size: 10px;
  font-weight: 800;
  text-align: center;
}

.image-missing .image-fallback {
  display: grid;
}

.card-caption {
  position: absolute;
  inset: auto 0 0;
  overflow: hidden;
  padding: 16px 7px 6px;
  color: #e8f3f0;
  background: linear-gradient(transparent, rgba(4, 10, 9, .96) 52%);
  font-size: 8px;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pokemon-overlay {
  position: absolute;
  inset: auto 0 0;
  padding: 22px 7px 7px;
  background: linear-gradient(transparent, rgba(3, 9, 8, .98) 38%);
}

.pokemon-name {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 5px;
  font-size: 8px;
}

.pokemon-name span {
  overflow: hidden;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pokemon-name b {
  flex: none;
  color: var(--accent);
  font-size: 7px;
}

.hp-bar {
  height: 3px;
  margin-top: 4px;
  border-radius: 999px;
  background: #20342f;
  overflow: hidden;
}

.hp-bar > span {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, var(--accent-deep), var(--gold));
}

.attachment-row {
  display: flex;
  flex-wrap: wrap;
  gap: 2px;
  margin-top: 4px;
}

.attachment-row span {
  padding: 2px 3px;
  border-radius: 3px;
  color: #b7cac6;
  background: rgba(42, 66, 61, .9);
  font-size: 5px;
}

.empty-slot {
  min-height: 72px;
  display: grid;
  place-items: center;
  padding: 10px;
  color: #4e6762;
  font-size: 9px;
}

.active-empty {
  min-height: 170px;
}

.private-row {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
}

.hand-zone {
  min-height: 93px;
  padding: 20px 7px 7px;
}

.hand-row {
  min-height: 64px;
}

.hand-row .card-shell {
  flex-basis: 68px;
  width: 68px;
  min-height: 94px;
  border-radius: 7px;
}

.hand-row .card-caption {
  padding: 12px 4px 4px;
  font-size: 6px;
}

.discard-zone {
  width: 96px;
  min-height: 93px;
  padding: 8px;
}

.discard-zone summary {
  color: var(--faint);
  cursor: pointer;
  font-size: 7px;
  font-weight: 950;
  list-style: none;
}

.discard-zone summary::-webkit-details-marker {
  display: none;
}

.discard-zone[open] {
  position: absolute;
  right: 14px;
  z-index: 20;
  width: min(620px, calc(100% - 28px));
  padding: 10px;
  box-shadow: var(--shadow);
}

.discard-row {
  margin-top: 8px;
}

.discard-row .card-shell {
  flex-basis: 72px;
  width: 72px;
  min-height: 101px;
  border-radius: 7px;
}

.hidden-card {
  flex: 0 0 46px !important;
  width: 46px !important;
  min-height: 65px !important;
  display: grid;
  place-items: center;
  border: 1px solid #33514b;
  background:
    linear-gradient(135deg, transparent 45%, rgba(143, 242, 107, .08) 46% 54%, transparent 55%),
    linear-gradient(45deg, #132723, #0a1614);
  cursor: default;
}

.hidden-card:hover {
  transform: none;
  border-color: #33514b;
}

.card-back-mark {
  color: #496b64;
  font-size: 6px;
  font-weight: 950;
  letter-spacing: .11em;
  transform: rotate(-25deg);
}

.opponent-side .private-row {
  opacity: .8;
}

.opponent-side .hand-zone {
  min-height: 74px;
}

.center-lane {
  min-height: 60px;
  display: grid;
  place-items: center;
  position: relative;
  margin: 7px 0;
}

.center-rule {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, #29443f, transparent);
}

.stadium-zone {
  position: relative;
  z-index: 2;
  padding: 7px 11px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--faint);
  background: #091412;
  font-size: 8px;
  font-weight: 850;
}

.stadium-zone b {
  color: var(--text);
}

.battle-result {
  position: absolute;
  inset: -3px 0;
  z-index: 4;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 211, 106, .45);
  border-radius: 11px;
  color: var(--gold);
  background: rgba(6, 14, 12, .94);
  font-size: 27px;
  font-weight: 950;
  letter-spacing: -.04em;
}

.control-rail {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 10px;
}

.decision-panel,
.timeline-panel {
  padding: 15px;
  box-shadow: none;
}

.selection-counter {
  flex: none;
  color: var(--muted);
  font-size: 9px;
}

.options {
  display: grid;
  gap: 7px;
  max-height: 400px;
  overflow-y: auto;
  padding-right: 2px;
}

.option {
  width: 100%;
  min-height: 54px;
  display: grid;
  grid-template-columns: 37px minmax(0, 1fr) 20px;
  align-items: center;
  gap: 9px;
  padding: 7px;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--text);
  background: #0a1614;
  cursor: pointer;
  text-align: left;
  transition: border-color .13s ease, background .13s ease, transform .13s ease;
}

.option:hover {
  border-color: #52726b;
  transform: translateY(-1px);
}

.option.selected {
  border-color: var(--accent);
  background: rgba(143, 242, 107, .08);
  box-shadow: inset 0 0 0 1px rgba(143, 242, 107, .1);
}

.option-thumb {
  width: 37px;
  height: 50px;
  border: 1px solid #35504b;
  border-radius: 5px;
  overflow: hidden;
}

.option-art-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--surface-2);
}

.option-art {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.option-symbol {
  width: 33px;
  height: 33px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 9px;
  color: var(--accent);
  background: var(--surface-2);
  font-size: 15px;
  font-weight: 900;
}

.option-copy {
  min-width: 0;
}

.option-title,
.option-detail {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-title {
  margin-bottom: 4px;
  font-size: 11px;
  font-weight: 900;
}

.option-detail {
  color: var(--muted);
  font-size: 8px;
}

.option-check {
  width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: transparent;
  font-size: 9px;
}

.option.selected .option-check {
  color: #0b1b10;
  border-color: var(--accent);
  background: var(--accent);
}

.decision-footer {
  display: flex;
  justify-content: flex-end;
  gap: 7px;
  margin-top: 11px;
}

.decision-footer .button {
  min-height: 37px;
  padding: 8px 12px;
  font-size: 10px;
}

.waiting-card {
  min-height: 112px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 6px;
  border: 1px dashed var(--line);
  border-radius: 11px;
  color: var(--muted);
  text-align: center;
}

.waiting-card strong {
  color: var(--text);
  font-size: 12px;
}

.waiting-card small {
  max-width: 280px;
  font-size: 8px;
  line-height: 1.5;
}

.mini-pulse {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--blue);
  box-shadow: 0 0 0 0 rgba(99, 184, 255, .35);
  animation: pulse 1.4s infinite;
}

@keyframes pulse {
  65% { box-shadow: 0 0 0 9px rgba(99, 184, 255, 0); }
  100% { box-shadow: 0 0 0 0 rgba(99, 184, 255, 0); }
}

.timeline {
  max-height: 330px;
  overflow-y: auto;
  padding-right: 3px;
}

.timeline-entry {
  min-height: 58px;
  display: grid;
  grid-template-columns: 24px 1px minmax(0, 1fr);
  gap: 8px;
  position: relative;
}

.timeline-index {
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--muted);
  background: var(--surface);
  font-size: 7px;
  font-weight: 900;
}

.timeline-entry.ai .timeline-index {
  color: var(--blue);
  border-color: rgba(99, 184, 255, .34);
}

.timeline-entry.human .timeline-index {
  color: var(--accent);
  border-color: rgba(143, 242, 107, .34);
}

.timeline-line {
  width: 1px;
  height: 100%;
  background: var(--line-soft);
}

.timeline-entry:last-child .timeline-line {
  background: linear-gradient(var(--line-soft), transparent);
}

.timeline-copy {
  min-width: 0;
  padding: 1px 0 11px;
}

.timeline-copy > span {
  display: flex;
  justify-content: space-between;
  gap: 7px;
}

.timeline-copy b {
  overflow: hidden;
  color: var(--muted);
  font-size: 8px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-copy small {
  flex: none;
  color: var(--faint);
  font-size: 7px;
}

.timeline-copy strong {
  display: block;
  overflow: hidden;
  margin-top: 3px;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-copy em {
  display: block;
  overflow: hidden;
  margin-top: 3px;
  color: var(--faint);
  font-size: 7px;
  font-style: normal;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-panel {
  padding: 0;
  box-shadow: none;
  overflow: hidden;
}

.log-panel summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 11px 14px;
  color: var(--muted);
  cursor: pointer;
  font-size: 9px;
  font-weight: 850;
  list-style: none;
}

.log-panel summary::-webkit-details-marker {
  display: none;
}

.log-panel summary span {
  color: var(--faint);
  font-size: 8px;
}

.logs {
  max-height: 240px;
  display: grid;
  gap: 5px;
  overflow-y: auto;
  padding: 0 13px 13px;
}

.log-entry {
  padding: 5px 0 5px 8px;
  border-left: 1px solid #35504b;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.4;
}

.empty-state {
  padding: 18px 10px;
  color: var(--faint);
  font-size: 9px;
  line-height: 1.5;
  text-align: center;
}

.toast {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 200;
  max-width: min(430px, calc(100% - 40px));
  padding: 12px 15px;
  border: 1px solid rgba(255, 115, 127, .45);
  border-radius: 11px;
  color: #ffdfe2;
  background: #2a1318;
  box-shadow: 0 20px 60px rgba(0, 0, 0, .42);
  font-size: 11px;
  line-height: 1.5;
}

.toast[data-tone="success"] {
  color: #d9ffe2;
  border-color: rgba(143, 242, 107, .42);
  background: #10271a;
}

.lobby-loading {
  position: fixed;
  inset: 0;
  z-index: 190;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(4, 10, 9, .78);
  backdrop-filter: blur(8px);
}

.loading-card {
  min-width: min(370px, 100%);
  display: grid;
  place-items: center;
  gap: 8px;
  padding: 28px;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: var(--surface);
  box-shadow: var(--shadow);
  text-align: center;
}

.loading-card strong {
  margin-top: 4px;
  font-size: 14px;
}

.loading-card span {
  color: var(--muted);
  font-size: 10px;
}

.spinner {
  width: 31px;
  height: 31px;
  border: 3px solid rgba(255, 255, 255, .1);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin .75s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.deck-builder-modal {
  width: min(1500px, calc(100% - 28px));
  height: min(900px, calc(100vh - 28px));
  max-width: none;
  max-height: none;
  padding: 0;
  border: 1px solid #38544f;
  border-radius: 20px;
  color: var(--text);
  background: #081210;
  box-shadow: 0 40px 120px rgba(0, 0, 0, .72);
  overflow: hidden;
}

.deck-builder-modal::backdrop {
  background: rgba(2, 7, 6, .9);
  backdrop-filter: blur(9px);
}

.builder-shell {
  height: 100%;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr) auto;
}

.builder-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 21px 23px 16px;
  border-bottom: 1px solid var(--line-soft);
  background:
    radial-gradient(circle at 0 0, rgba(143, 242, 107, .11), transparent 25rem),
    #0b1715;
}

.builder-header h2 {
  font-size: 27px;
}

.builder-header p {
  margin: 7px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.builder-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.modal-close.static-close {
  position: static;
}

.builder-toolbar {
  display: grid;
  grid-template-columns: minmax(260px, 1fr) minmax(250px, .7fr) auto;
  align-items: end;
  gap: 10px;
  padding: 12px 17px;
  border-bottom: 1px solid var(--line-soft);
  background: #091412;
}

.builder-toolbar label {
  display: grid;
  gap: 6px;
}

.builder-toolbar label > span {
  color: var(--faint);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.builder-toolbar input,
.builder-toolbar select,
.builder-searchbar input,
.builder-searchbar select {
  width: 100%;
  height: 40px;
  padding: 0 11px;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--text);
  background: #07100f;
}

.builder-layout {
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(390px, .72fr);
}

.builder-catalog-pane,
.builder-deck-pane {
  min-width: 0;
  min-height: 0;
  display: grid;
  padding: 15px;
}

.builder-catalog-pane {
  grid-template-rows: auto auto minmax(0, 1fr) auto auto;
  border-right: 1px solid var(--line-soft);
}

.builder-catalog-pane.drag-remove {
  background: rgba(255, 115, 127, .045);
}

.builder-searchbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180px;
  gap: 8px;
}

.builder-result-heading {
  min-height: 35px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted);
  font-size: 10px;
}

.builder-result-heading small {
  color: var(--faint);
  font-size: 8px;
}

.builder-card-grid {
  min-height: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(125px, 1fr));
  align-content: start;
  gap: 9px;
  overflow-y: auto;
  padding: 2px 6px 8px 2px;
}

.builder-card-item {
  position: relative;
  min-width: 0;
  padding: 7px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #0b1715;
  cursor: grab;
  transition: border-color .14s ease, transform .14s ease, opacity .14s ease;
}

.builder-card-item:hover {
  border-color: #58766f;
  transform: translateY(-2px);
}

.builder-card-item.dragging,
.builder-deck-row.dragging {
  opacity: .42;
}

.builder-card-art {
  position: relative;
  width: 100%;
  aspect-ratio: .716;
  overflow: hidden;
  border-radius: 8px;
  background: #101f1c;
}

.builder-card-art img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.builder-card-art .image-fallback {
  display: grid;
  place-items: center;
  padding: 8px;
  color: var(--muted);
  font-size: 9px;
  text-align: center;
}

.builder-card-art img + .image-fallback {
  display: none;
}

.builder-card-copy {
  min-width: 0;
  padding: 7px 1px 1px;
}

.builder-card-copy strong,
.builder-card-copy small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.builder-card-copy strong {
  font-size: 10px;
}

.builder-card-copy small {
  margin-top: 4px;
  color: var(--faint);
  font-size: 8px;
}

.builder-add-card {
  position: absolute;
  right: 12px;
  bottom: 34px;
  width: 29px;
  height: 29px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(143, 242, 107, .56);
  border-radius: 9px;
  color: #09200f;
  background: var(--accent);
  box-shadow: 0 5px 20px rgba(0, 0, 0, .44);
  cursor: pointer;
  font-size: 18px;
  font-weight: 900;
}

.builder-more {
  justify-self: center;
  min-width: 160px;
  margin-top: 5px;
}

.builder-remove-zone {
  min-height: 28px;
  display: grid;
  place-items: center;
  margin-top: 8px;
  border: 1px dashed rgba(255, 115, 127, .24);
  border-radius: 8px;
  color: var(--faint);
  font-size: 8px;
  transition: border-color .14s ease, color .14s ease, background .14s ease;
}

.builder-remove-zone.drag-over {
  border-color: var(--danger);
  color: #ffdfe2;
  background: rgba(255, 115, 127, .09);
}

.builder-deck-pane {
  grid-template-rows: auto auto minmax(0, 1fr) auto;
  background:
    radial-gradient(circle at 100% 0, rgba(99, 184, 255, .08), transparent 25rem),
    #091412;
}

.builder-deck-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}

.builder-deck-heading .kicker {
  margin-bottom: 4px;
}

#builder-count {
  font-size: 24px;
  letter-spacing: -.04em;
}

#builder-count.complete {
  color: var(--accent);
}

#builder-count.over {
  color: var(--danger);
}

.builder-type-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 4px;
}

.builder-type-stats span {
  padding: 4px 6px;
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--muted);
  font-size: 8px;
}

.deck-progress {
  height: 4px;
  overflow: hidden;
  border-radius: 999px;
  background: #172725;
}

.deck-progress span {
  width: 0;
  height: 100%;
  display: block;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--blue), var(--accent));
  transition: width .18s ease;
}

.builder-deck-list {
  min-height: 0;
  display: grid;
  align-content: start;
  gap: 6px;
  overflow-y: auto;
  margin: 10px -2px 0;
  padding: 2px 5px 8px 2px;
  border-radius: 10px;
  transition: background .14s ease, box-shadow .14s ease;
}

.builder-deck-list.drag-over {
  background: rgba(143, 242, 107, .055);
  box-shadow: inset 0 0 0 1px rgba(143, 242, 107, .36);
}

.builder-empty {
  min-height: 230px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 7px;
  border: 1px dashed #38534e;
  border-radius: 12px;
  color: var(--muted);
  text-align: center;
}

.builder-empty strong {
  font-size: 12px;
}

.builder-empty span {
  color: var(--faint);
  font-size: 9px;
}

.builder-deck-row {
  min-width: 0;
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  min-height: 62px;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: rgba(7, 16, 15, .88);
  cursor: grab;
}

.builder-deck-thumb {
  width: 46px;
  height: 48px;
  overflow: hidden;
  border-radius: 6px;
  background: var(--surface);
}

.builder-deck-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
}

.builder-deck-copy {
  min-width: 0;
}

.builder-deck-copy strong,
.builder-deck-copy small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.builder-deck-copy strong {
  font-size: 10px;
}

.builder-deck-copy small {
  margin-top: 4px;
  color: var(--faint);
  font-size: 8px;
}

.builder-quantity {
  display: grid;
  grid-template-columns: 29px 32px 29px;
  align-items: center;
}

.builder-quantity button {
  width: 29px;
  height: 29px;
  border: 1px solid var(--line);
  color: var(--text);
  background: var(--surface-2);
  cursor: pointer;
  font-weight: 900;
}

.builder-quantity button:first-child {
  border-radius: 8px 0 0 8px;
}

.builder-quantity button:last-child {
  border-radius: 0 8px 8px 0;
}

.builder-quantity span {
  height: 29px;
  display: grid;
  place-items: center;
  border-block: 1px solid var(--line);
  font-size: 10px;
  font-weight: 900;
}

.builder-rule-note {
  padding-top: 8px;
  border-top: 1px solid var(--line-soft);
  color: var(--faint);
  font-size: 8px;
  line-height: 1.45;
}

.builder-rule-note.error {
  color: var(--danger);
}

.builder-footer {
