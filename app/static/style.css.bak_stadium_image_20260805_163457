/* Replay viewer */
.replay-import-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 28px;
  margin-top: 14px;
  padding: 24px 28px;
  border-style: dashed;
  background:
    radial-gradient(circle at 92% 12%, rgba(143, 242, 107, .08), transparent 27%),
    linear-gradient(145deg, rgba(12, 28, 24, .94), rgba(7, 16, 14, .98));
  transition: border-color .18s ease, background .18s ease, transform .18s ease;
}

.replay-import-panel.dragging {
  border-color: var(--accent);
  background:
    radial-gradient(circle at 92% 12%, rgba(143, 242, 107, .18), transparent 32%),
    linear-gradient(145deg, rgba(14, 35, 28, .98), rgba(7, 16, 14, .98));
  transform: translateY(-2px);
}

.replay-import-copy h2 {
  margin: 5px 0 8px;
  font-size: clamp(20px, 2vw, 28px);
}

.replay-import-copy p {
  max-width: 780px;
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.65;
}

.replay-import-copy code {
  padding: 2px 5px;
  border: 1px solid var(--line-soft);
  border-radius: 5px;
  color: var(--accent);
  background: rgba(0, 0, 0, .24);
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: .92em;
}

.replay-import-actions {
  min-width: 190px;
  display: grid;
  justify-items: stretch;
  gap: 7px;
}

.replay-import-actions small {
  color: var(--faint);
  text-align: center;
  font-size: 8px;
  letter-spacing: .12em;
}

.replay-controls {
  display: grid;
  grid-template-columns: minmax(180px, .55fr) minmax(320px, 1.45fr) auto;
  align-items: center;
  gap: 20px;
  margin-bottom: 12px;
  padding: 13px 16px;
}

.replay-file-meta {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.replay-file-meta strong,
.replay-file-meta small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.replay-file-meta strong {
  font-size: 11px;
}

.replay-file-meta small {
  color: var(--faint);
  font-size: 8px;
}

.replay-scrubber-wrap {
  min-width: 0;
  display: grid;
  gap: 6px;
}

#replay-scrubber {
  width: 100%;
  accent-color: var(--accent);
  cursor: pointer;
}

.replay-frame-meta {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  color: var(--muted);
  font-size: 8px;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.replay-seat-field {
  min-width: 158px;
  display: grid;
  gap: 5px;
}

.replay-seat-field > span {
  color: var(--faint);
  font-size: 8px;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.replay-seat-field select {
  min-height: 36px;
}

.game.replay-mode .decision-panel {
  border-color: rgba(120, 156, 148, .55);
}

.game.replay-mode .decision-footer {
  display: none;
}

.game.replay-mode .option {
  cursor: default;
  pointer-events: none;
}

.game.replay-mode .option.replay-selected {
  border-color: var(--accent);
  background: linear-gradient(145deg, rgba(143, 242, 107, .16), rgba(15, 35, 29, .92));
  box-shadow: inset 3px 0 0 var(--accent);
}

.game.replay-mode .option.replay-selected .option-check {
  opacity: 1;
  color: var(--accent);
}

.game.replay-mode .waiting-card small {
  max-width: 260px;
}

.timeline-entry[data-frame-index] {
  cursor: pointer;
  border-radius: 8px;
  transition: background .14s ease;
}

.timeline-entry[data-frame-index]:hover,
.timeline-entry.current-frame {
  background: rgba(143, 242, 107, .07);
}

.timeline-entry.current-frame .timeline-index {
  color: var(--accent);
  border-color: var(--accent);
}

.replay-open-button {
  border-color: rgba(143, 242, 107, .3);
}

@media (max-width: 1040px) {
  .replay-controls {
    grid-template-columns: minmax(180px, .7fr) minmax(260px, 1.3fr);
  }

  .replay-seat-field {
    grid-column: 1 / -1;
    grid-template-columns: auto minmax(180px, 280px);
    align-items: center;
    justify-content: end;
  }
}

@media (max-width: 760px) {
  .replay-import-panel,
  .replay-controls {
    grid-template-columns: 1fr;
  }

  .replay-import-panel {
    gap: 18px;
    padding: 18px;
  }

  .replay-import-actions {
    min-width: 0;
  }

  .replay-seat-field {
    grid-column: auto;
    grid-template-columns: 1fr;
    justify-content: stretch;
  }
}

