/* Online player matchmaking */
.online-match-panel {
  margin-top: 18px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(360px, 0.9fr);
  gap: 28px;
  align-items: center;
  padding: 28px;
  position: relative;
  overflow: hidden;
}

.online-match-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(circle at 88% 14%, rgba(91, 140, 255, 0.16), transparent 38%);
}

.online-match-copy,
.online-match-actions,
.online-capacity {
  position: relative;
  z-index: 1;
}

.online-match-copy h2 {
  margin: 5px 0 8px;
  font-size: clamp(24px, 3vw, 38px);
}

.online-match-copy p {
  margin: 0;
  max-width: 640px;
  color: var(--muted);
  line-height: 1.65;
}

.online-match-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.online-match-actions > .primary {
  grid-column: 1 / -1;
  min-height: 58px;
  font-size: 16px;
}

.room-code-join {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
}

.room-code-join input {
  min-width: 0;
  height: 46px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: rgba(8, 13, 25, 0.74);
  color: var(--text);
  padding: 0 14px;
  font: inherit;
  text-transform: uppercase;
  letter-spacing: 0.18em;
}

.online-capacity {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 12px;
}

.matchmaking-status {
  margin-top: 18px;
  padding: 22px 26px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 20px;
  border-color: rgba(91, 140, 255, 0.42);
  background: linear-gradient(135deg, rgba(18, 29, 55, 0.96), rgba(11, 17, 31, 0.96));
}

.matchmaking-copy h2 {
  margin: 4px 0 4px;
  font-size: 21px;
}

.matchmaking-copy p {
  margin: 0;
  color: var(--muted);
}

.matchmaking-pulse {
  display: flex;
  gap: 5px;
  align-items: center;
  min-width: 48px;
}

.matchmaking-pulse span {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--accent);
  animation: matchmaking-bounce 1.1s ease-in-out infinite;
}

.matchmaking-pulse span:nth-child(2) { animation-delay: 0.14s; }
.matchmaking-pulse span:nth-child(3) { animation-delay: 0.28s; }

@keyframes matchmaking-bounce {
  0%, 65%, 100% { transform: translateY(0); opacity: 0.38; }
  30% { transform: translateY(-6px); opacity: 1; }
}

.room-code-display {
  margin-top: 12px;
  border: 1px solid rgba(91, 140, 255, 0.46);
  border-radius: 12px;
  background: rgba(91, 140, 255, 0.1);
  color: var(--text);
  padding: 9px 14px;
  font: 800 20px/1 ui-monospace, SFMono-Regular, Consolas, monospace;
  letter-spacing: 0.22em;
  cursor: pointer;
}

.game.pvp-mode .playback .icon-button,
.game.pvp-mode .playback select {
  display: none;
}

.game.pvp-mode .playback-label {
  min-width: 112px;
  text-align: center;
}

.game.pvp-mode #result-submit-panel {
  display: none !important;
}

.opponent-connectivity {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.opponent-connectivity::before {
  content: '';
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #32d583;
  box-shadow: 0 0 10px rgba(50, 213, 131, 0.58);
}

.opponent-connectivity.offline::before {
  background: #f79009;
  box-shadow: none;
}

@media (max-width: 900px) {
  .online-match-panel {
    grid-template-columns: 1fr;
    padding: 22px;
  }

  .matchmaking-status {
    grid-template-columns: auto 1fr;
  }

  .matchmaking-status > .button {
    grid-column: 1 / -1;
    width: 100%;
  }
}

@media (max-width: 560px) {
  .online-match-actions {
    grid-template-columns: 1fr;
  }

  .online-match-actions > .primary,
  .room-code-join {
    grid-column: 1;
  }

  .room-code-join {
    grid-template-columns: 1fr;
  }

  .matchmaking-status {
    padding: 18px;
    gap: 14px;
  }
}

/* PTCG_UI_PRIZE_CHECK_V1 */
.pokemon-stack { position: relative; }
.board-card-id {
  position: absolute;
  z-index: 7;
  top: .38rem;
  left: .38rem;
  display: inline-grid;
  place-items: center;
  min-width: 2rem;
  height: 2rem;
  padding: 0 .48rem;
  border-radius: .65rem;
  background: rgba(8, 13, 24, .92);
  border: 1px solid rgba(255, 255, 255, .72);
  box-shadow: 0 5px 18px rgba(0, 0, 0, .35);
  color: #fff;
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .04em;
  pointer-events: none;
}
.pokemon-location {
  margin-top: .2rem;
  color: rgba(255,255,255,.78);
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .04em;
}
.option-detail { line-height: 1.35; }
.prize-check-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border-color: rgba(250, 204, 21, .38);
  background: linear-gradient(135deg, rgba(250, 204, 21, .12), rgba(15, 23, 42, .92));
}
.prize-check-panel-copy { display: grid; gap: .28rem; min-width: 0; }
.prize-check-panel-copy strong { font-size: .98rem; }
.prize-check-panel-copy small { color: var(--muted, #9ca3af); line-height: 1.4; }
.prize-check-dialog {
  width: min(1050px, calc(100vw - 2rem));
  max-height: calc(100vh - 2rem);
  padding: 0;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 1.2rem;
  background: #0b1220;
  color: #f8fafc;
  box-shadow: 0 30px 90px rgba(0,0,0,.55);
}
.prize-check-dialog::backdrop { background: rgba(2, 6, 23, .78); backdrop-filter: blur(6px); }
.prize-check-shell { padding: 1.2rem; overflow: auto; max-height: calc(100vh - 2rem); }
.prize-check-header, .prize-check-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}
.prize-check-header h2 { margin: .25rem 0 .15rem; }
.prize-check-header p { margin: 0; color: #94a3b8; }
.prize-check-note {
  margin: 1rem 0;
  padding: .85rem 1rem;
  border-radius: .8rem;
  background: rgba(59, 130, 246, .12);
  border: 1px solid rgba(96, 165, 250, .25);
  color: #bfdbfe;
  line-height: 1.5;
}
.prize-check-section { margin-top: 1.25rem; }
.prize-check-section-heading { align-items: center; margin-bottom: .65rem; }
.prize-check-section-heading h3 { margin: 0; }
.prize-check-section-heading strong { color: #fde047; }
.prize-check-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: .65rem;
}
.prize-check-card {
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr) auto;
  align-items: center;
  gap: .75rem;
  width: 100%;
  padding: .55rem;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: .8rem;
  background: rgba(255,255,255,.055);
  color: inherit;
  text-align: left;
  cursor: pointer;
}
.prize-check-card:hover { border-color: rgba(250,204,21,.58); transform: translateY(-1px); }
.prize-check-art { width: 48px; aspect-ratio: 2.5 / 3.5; overflow: hidden; border-radius: .35rem; background: #111827; }
.prize-check-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
.prize-check-card span:nth-child(2) { display: grid; min-width: 0; }
.prize-check-card b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.prize-check-card small { color: #94a3b8; }
.prize-check-card > strong { font-size: 1.05rem; color: #fde047; }
.prize-check-empty { padding: 1rem; border: 1px dashed rgba(255,255,255,.18); border-radius: .8rem; color: #94a3b8; }
@media (max-width: 680px) {
  .prize-check-panel { align-items: stretch; flex-direction: column; }
  .prize-check-panel .button { width: 100%; }
  .prize-check-grid { grid-template-columns: 1fr; }
  .board-card-id { min-width: 1.7rem; height: 1.7rem; font-size: .68rem; }
}

/* PTCG_AI_DECK_VIEW_V2 */
.agent-card-wrap-v2 {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 66px;
  gap: 7px;
}

.agent-card-wrap-v2 > .agent-card {
  width: 100%;
}

.agent-deck-button-v2 {
  border: 1px solid rgba(143, 242, 107, .35);
  border-radius: 11px;
  color: var(--accent);
  background: rgba(143, 242, 107, .07);
  font-size: 10px;
  font-weight: 900;
  cursor: pointer;
}

.agent-deck-button-v2:disabled {
  opacity: .35;
  cursor: not-allowed;
}

.agent-deck-dialog {
  width: min(1100px, calc(100vw - 28px));
  max-height: calc(100vh - 28px);
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 20px;
  color: var(--text);
  background: #091312;
}

.agent-deck-dialog::backdrop {
  background: rgba(0, 0, 0, .72);
}

.agent-deck-shell {
  max-height: calc(100vh - 30px);
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  overflow: hidden;
}

.agent-deck-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 24px;
  border-bottom: 1px solid var(--line-soft);
}

.agent-deck-header h2 {
  margin: 0 0 6px;
}

.agent-deck-header p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.agent-deck-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 11px 24px;
  border-bottom: 1px solid var(--line-soft);
}

.agent-deck-summary span {
  padding: 7px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  font-size: 10px;
}

.agent-deck-summary .valid {
  color: var(--accent);
}

.agent-deck-summary .invalid {
  color: var(--danger);
}

.agent-deck-content {
  overflow: auto;
  padding: 22px 24px 28px;
}

.agent-deck-section + .agent-deck-section {
  margin-top: 26px;
}

.agent-deck-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.agent-deck-section-title h3 {
  margin: 0;
}

.agent-deck-section-title strong {
  color: var(--muted);
  font-size: 11px;
}

.agent-deck-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}

.agent-deck-card {
  min-width: 0;
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
  padding: 9px;
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--text);
  background: rgba(9, 20, 18, .76);
  text-align: left;
  cursor: pointer;
}

.agent-deck-thumb {
  width: 58px;
  height: 81px;
}

.agent-deck-art-wrap {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  border-radius: 7px;
}

.agent-deck-art {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.agent-deck-copy strong,
.agent-deck-copy small {
  display: block;
}

.agent-deck-copy strong {
  margin-bottom: 6px;
  font-size: 12px;
}

.agent-deck-copy strong b {
  display: inline-grid;
  min-width: 24px;
  height: 24px;
  place-items: center;
  margin-right: 5px;
  border-radius: 7px;
  color: #0b1b0e;
  background: var(--accent);
}

.agent-deck-copy small {
  color: var(--muted);
  font-size: 9px;
}

.agent-deck-loading,
.agent-deck-error {
  min-height: 240px;
  display: grid;
  place-items: center;
  color: var(--muted);
  text-align: center;
}

@media (max-width: 900px) {
  .agent-deck-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .agent-card-wrap-v2 {
    grid-template-columns: minmax(0, 1fr) 58px;
  }

  .agent-deck-grid {
    grid-template-columns: 1fr;
  }

  .agent-deck-header,
  .agent-deck-summary,
  .agent-deck-content {
    padding-left: 14px;
    padding-right: 14px;
  }
}
