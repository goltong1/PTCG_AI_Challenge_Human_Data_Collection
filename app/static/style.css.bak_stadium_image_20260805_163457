}

.attached-card-mini img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.attached-card-mini > span {
  display: none;
}

.attachment-overflow {
  min-width: 23px;
  height: 23px;
  display: grid;
  place-items: center;
  margin-left: 3px;
  border-radius: 999px;
  color: var(--text);
  background: #243e38;
  font-size: 7px;
  font-weight: 900;
}

.energy-type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
}

.energy-type-chip {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 2px 4px;
  border: 1px solid rgba(99, 184, 255, .2);
  border-radius: 999px;
  color: #bed9e9;
  background: rgba(25, 53, 67, .72);
  font-size: 6px;
  font-weight: 800;
  white-space: nowrap;
}

.energy-type-chip b {
  color: #fff;
  font-size: 7px;
}

.tool-row {
  min-width: 0;
  display: grid;
  gap: 2px;
}

.tool-chip {
  overflow: hidden;
  padding: 3px 4px;
  border: 1px solid rgba(255, 194, 88, .18);
  border-radius: 4px;
  color: #e8c58c;
  background: rgba(61, 42, 14, .72);
  font-size: 6px;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
  cursor: pointer;
}

.private-row {
  grid-template-columns: minmax(0, 1fr) 226px;
}

.discard-zone {
  width: 226px;
  min-height: 104px;
  padding: 7px;
}

.discard-zone summary {
  min-height: 88px;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr);
  grid-template-rows: 1fr auto;
  align-items: center;
  gap: 4px 8px;
}

.discard-summary-icon {
  grid-row: 1 / 3;
  width: 52px;
  height: 74px;
  display: grid;
  place-items: center;
  border: 1px solid #36504a;
  border-radius: 6px;
  background: #091512;
  overflow: hidden;
}

.discard-summary-art-wrap,
.discard-summary-art {
  width: 100%;
  height: 100%;
}

.discard-summary-art {
  object-fit: cover;
}

.discard-summary-copy {
  min-width: 0;
  display: grid;
  gap: 4px;
}

.discard-summary-copy b {
  overflow: hidden;
  color: var(--text);
  font-size: 9px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.discard-summary-copy small {
  color: var(--faint);
  font-size: 7px;
}

.discard-expand {
  color: var(--accent);
  font-size: 7px;
  font-weight: 900;
}

.discard-zone[open] {
  right: 14px;
  width: min(760px, calc(100% - 28px));
}

.discard-zone[open] summary {
  min-height: auto;
  display: flex;
}

.discard-zone[open] .discard-summary-icon {
  width: 34px;
  height: 48px;
  flex: none;
}

.discard-row {
  max-height: 360px;
  flex-wrap: wrap;
  overflow-y: auto;
}

@media (max-width: 1080px) {
  .player-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .player-resources {
    width: 100%;
    justify-content: flex-start;
  }

  .private-row {
    grid-template-columns: minmax(0, 1fr) 190px;
  }

  .discard-zone {
    width: 190px;
  }
}

@media (max-width: 720px) {
  .player-resources {
    display: grid;
    grid-template-columns: 52px 52px minmax(114px, 1fr) 56px;
  }

  .battle-row {
    grid-template-columns: 122px minmax(0, 1fr);
  }

  .active-zone,
  .bench-zone {
    min-height: 260px;
  }

  .bench-row {
    min-height: 224px;
  }

  .pokemon-stack {
    flex-basis: 108px;
    width: 108px;
  }

  .pokemon-stack.compact-stack {
    flex-basis: 82px;
    width: 82px;
  }

  .pokemon-stack > .card-shell {
    min-height: 151px;
  }

  .pokemon-stack.compact-stack > .card-shell {
    min-height: 115px;
  }

  .attachment-panel {
    min-height: 60px;
  }

  .private-row {
    grid-template-columns: minmax(0, 1fr) 126px;
  }

  .discard-zone {
    width: 126px;
  }

  .discard-zone summary {
    grid-template-columns: 38px minmax(0, 1fr);
  }

  .discard-summary-icon {
    width: 38px;
    height: 54px;
  }

  .discard-summary-copy b {
    font-size: 7px;
  }

  .result-submit-panel {
    align-items: stretch;
    flex-direction: column;
  }
}

@media (max-width: 480px) {
  .player-resources {
    grid-template-columns: 46px 46px minmax(100px, 1fr) 52px;
    gap: 4px;
  }

  .resource-number,
  .prize-resource,
  .discard-resource {
    min-height: 48px;
  }

  .prize-resource {
    min-width: 0;
  }

  .prize-card {
    width: 9px;
    height: 14px;
  }

  .battle-row {
    grid-template-columns: 108px minmax(0, 1fr);
  }

  .private-row {
    display: grid;
    grid-template-columns: 1fr;
  }

  .discard-zone {
    width: 100%;
  }

  .discard-zone summary {
    min-height: 66px;
    grid-template-columns: 38px minmax(0, 1fr);
  }
}

