  updatePlaybackButtons();
  updateResultSubmitPanel(data);
  if (replayMode) {
    if (replayPlaying) scheduleReplay();
  } else if (pvpMode) {
    schedulePvpPoll();
  } else {
    scheduleAi();
    maybeAutoSubmit(data);
  }
