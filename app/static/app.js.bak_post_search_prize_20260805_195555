  }

  renderPlayerSide(
    $('#ai-side'),
    data.ai,
    replayMode ? data.ai.hand !== null : false,
    topName,
    (replayMode || pvpMode) ? `P${data.ai_seat}` : 'AI',
  );
  renderPlayerSide(
    $('#human-side'),
    data.human,
    replayMode ? data.human.hand !== null : true,
    bottomName,
