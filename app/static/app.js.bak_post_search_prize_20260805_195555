let stadiumCardIndexPromiseV1 = null;

async function getStadiumCardIndexV1() {
  if (!stadiumCardIndexPromiseV1) {
    stadiumCardIndexPromiseV1 = api('/api/cards').then((payload) => {
      const items = Array.isArray(payload?.cards) ? payload.cards : (Array.isArray(payload) ? payload : []);
      const byName = new Map();
      items.forEach((card) => {
        const type = String(card?.type || '').toUpperCase();
        const name = String(card?.name || '').trim();
        if (type === 'STADIUM' && name && !byName.has(name)) byName.set(name, card);
      });
      return byName;
    }).catch((error) => {
      console.warn('stadium card index load failed', error);
      return new Map();
    });
  }
  return stadiumCardIndexPromiseV1;
}

function findStadiumNameV1(text) {
  const raw = String(text || '').replace(/\s+/g, ' ').trim();
  if (!raw) return '';
  const patterns = [
    /^(?:스타디움|stadium)\s*[:：-]?\s*(.+)$/i,
    /^(?:경기장)\s*[:：-]?\s*(.+)$/i,
  ];
  for (const pattern of patterns) {
    const match = raw.match(pattern);
    if (match?.[1]) return match[1].trim();
  }
  return '';
}

function findStadiumLabelNodesV1() {
  const selectors = [
    '.stadium-name',
    '.stadium-slot',
    '.board-stadium',
    '.stadium',
    '[data-stadium]',
    '[data-zone="stadium"]',
    '.turn-panel',
    '.board-meta',
    '.status-panel',
    '.top-info',
  ];
  const found = new Set();
  selectors.forEach((selector) => {
    document.querySelectorAll(selector).forEach((node) => {
      if (node && node.nodeType === 1) found.add(node);
    });
  });

  document.querySelectorAll('div, span, p, strong, small').forEach((node) => {
    if (node.children.length > 0) return;
    const text = node.textContent || '';
    if (findStadiumNameV1(text)) found.add(node);
  });

  return [...found];
}

function buildStadiumThumbV1(card) {
  const button = document.createElement('button');
  button.type = 'button';
  button.className = 'stadium-image-chip-v1';
  button.setAttribute('aria-label', `${card?.name || '스타디움'} 카드 보기`);

  if (typeof registerCard === 'function') {
    const key = registerCard(card);
    button.dataset.cardKey = key;
    button.classList.add('card-click');
  }

  button.innerHTML = `
    <span class="stadium-image-thumb-v1">${imageHtml(card, 'stadium-image-art-v1')}</span>
    <span class="stadium-image-copy-v1">
      <span class="stadium-image-label-v1">스타디움</span>
      <strong>${esc(card?.name || '알 수 없는 경기장')}</strong>
    </span>`;

  if (typeof openCardModal === 'function') {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      openCardModal(card);
    });
  }
  return button;
}

async function enhanceStadiumDisplayV1() {
  const nodes = findStadiumLabelNodesV1();
  if (!nodes.length) return;
  const index = await getStadiumCardIndexV1();
  if (!index.size) return;

  nodes.forEach((node) => {
    if (!(node instanceof HTMLElement)) return;
    if (node.querySelector('.stadium-image-chip-v1')) return;
    const text = node.textContent || '';
    const stadiumName = findStadiumNameV1(text);
    if (!stadiumName) return;
    const card = index.get(stadiumName);
    if (!card) return;

    const host = document.createElement('div');
    host.className = 'stadium-image-host-v1';
    host.appendChild(buildStadiumThumbV1(card));

    if (node.children.length === 0) {
      const textLabel = document.createElement('span');
      textLabel.className = 'stadium-image-text-v1';
      textLabel.textContent = text;
      host.appendChild(textLabel);
      node.textContent = '';
      node.appendChild(host);
    } else {
      node.prepend(host);
    }
  });
}

function installStadiumImagePatchV1() {
  if (document.documentElement.dataset.stadiumImagePatchV1 === '1') return;
  document.documentElement.dataset.stadiumImagePatchV1 = '1';

  const rerender = () => {
    Promise.resolve().then(() => enhanceStadiumDisplayV1()).catch((error) => {
      console.warn('stadium image enhancement failed', error);
    });
  };

  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type !== 'childList') continue;
      if (mutation.addedNodes.length) {
        rerender();
        break;
      }
    }
  });

  observer.observe(document.body || document.documentElement, { childList: true, subtree: true });
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', rerender, { once: true });
  } else {
    rerender();
  }
}

installStadiumImagePatchV1();

