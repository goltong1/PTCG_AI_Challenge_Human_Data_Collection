    : `서치할 때 저장한 덱·프라이즈 기록입니다. 이후 프라이즈를 가져갔다면 실제 남은 장수와 비교하세요.`;
  $('#prize-check-open').textContent = live ? '지금 프라이즈 체크' : '체크 기록 다시 보기';
}
function openPrizeCheckDialog() {
