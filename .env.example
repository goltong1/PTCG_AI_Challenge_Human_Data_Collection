# Public hostname used by Caddy. Point its DNS A/AAAA record to the VPS first.
CABT_DOMAIN=arena.example.com

# Replace with a long random value. Used only for /admin and admin APIs.
CABT_ADMIN_TOKEN=replace-with-a-long-random-token

# Capacity controls. One PvP match owns one native CABT worker process.
CABT_MAX_SESSIONS=4
CABT_MAX_PVP_MATCHES=4
CABT_MAX_PVP_WAITERS=32
CABT_SESSION_IDLE_SECONDS=3600
CABT_PVP_QUEUE_TIMEOUT=600
CABT_PVP_MATCH_IDLE_SECONDS=7200
